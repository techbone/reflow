# Copy to .env. Never commit .env. Values below are the Arc Mainnet release.

# Client (baked into the build)
VITE_REFLOW_NETWORK=mainnet            # testnet (default) or mainnet
VITE_REFLOW_CONTRACT=0x8EB21094f6cEF274a2e4E31C86CA9027f3b5F3F8
VITE_REFLOW_POOL_ID=1
VITE_REFLOW_FROM_BLOCK=28894881

# Delivery server (not used by the static hosted build)
REFLOW_POOL_ID=1
# HMAC_SECRET=<32-byte hex>            # random per start if unset (tokens reset on restart)
# PUBLIC_ORIGIN=http://localhost:5173  # origin and host used in the signed unlock message
# DOMAIN=localhost:5173
# DELIVERY_PORT=8791
